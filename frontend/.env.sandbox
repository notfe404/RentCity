# ============================================================
# PayPal Sandbox Configuration
# ============================================================
# Get these from: https://developer.paypal.com/ → Apps & Credentials → Sandbox
VITE_PAYPAL_CLIENT_ID=AWc1CIvnDWMDr0aFcT1vmuA0oUdoWISrNITZzU7Grvk_LAOWqdImmN8vt_7PG9zrcnm6-XKFGazC9HjJ
paypal.client-secret=EJlzlo5P01_3syjcKwaaKTZV1EfqIffLYY74bQtc4bHg5WIZiyCHrxt_WONEcFAh2GEq5zUHlq9iSP9Z
paypal.mode=sandbox
paypal.api-url=https://api.sandbox.paypal.com
paypal.return-url=http://localhost:5173/booking/result
paypal.cancel-url=http://localhost:5173/payments
paypal.currency=USD

# ============================================================
# VNPay Sandbox Configuration
# ============================================================
# Get these from: https://sandbox.vnpayment.vn/ → Dashboard → Settings
vnpay.tmn-code=PASTE_YOUR_VNPAY_TMN_CODE_HERE
vnpay.secret-key=PASTE_YOUR_VNPAY_SECRET_KEY_HERE
vnpay.api-url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.return-url=http://localhost:8081/api/payments/vnpay/callback
vnpay.command=pay
vnpay.order-type=100000
vnpay.currency=VND
vnpay.locale=vn
vnpay.timeout=15
vnpay.version=2.1.0

# ============================================================
# Payment Service Configuration
# ============================================================
payment.public-base-url=http://localhost:8081/api
payment.min-deposit-percent=50
payment.max-deposit-percent=100

# ============================================================
# Database Configuration (if needed)
# ============================================================
spring.datasource.url=jdbc:postgresql://127.0.0.1:5434/rentcity
spring.datasource.username=rentcity_user
spring.datasource.password=rentcity_pass

# ============================================================
# JWT Configuration (if needed)
